# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
HA_ENV=dev
HA_LOG_LEVEL=INFO

# SQLite path. Use a mounted volume in production, or swap Store for Postgres.
HA_DB_PATH=./var/hospital.db

# ---------------------------------------------------------------------------
# LLM
#   deterministic -> no network, rule-based planner (default; used in CI/demo)
#   openai        -> any OpenAI-compatible /chat/completions endpoint
# ---------------------------------------------------------------------------
HA_LLM_PROVIDER=deterministic
HA_LLM_BASE_URL=https://api.openai.com/v1
HA_LLM_API_KEY=
HA_LLM_MODEL=gpt-4o-mini
HA_LLM_TIMEOUT_S=30

# ---------------------------------------------------------------------------
# Guardrails / budgets
# ---------------------------------------------------------------------------
HA_MAX_STEPS=8
HA_TOKEN_BUDGET=12000
HA_RUN_TIMEOUT_S=45
HA_REQUIRE_PHI_PURPOSE=true
HA_APPROVAL_TTL_S=1800
HA_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Auth: JSON map of api-key -> principal. NEVER commit real keys.
#   {"<key>": {"sub": "u1", "role": "admin", "tenant": "stmarys",
#              "purposes": ["treatment", "operations", "payment"]}}
# Roles: service | analyst | scheduler | billing | clinician | admin
# ---------------------------------------------------------------------------
HA_API_KEYS={"dev-admin-key":{"sub":"local-admin","role":"admin","tenant":"demo","purposes":["treatment","operations","payment","research"]},"dev-analyst-key":{"sub":"local-analyst","role":"analyst","tenant":"demo","purposes":["operations"]}}

# Rate limit (requests per minute per api key)
HA_RATE_LIMIT_RPM=240

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
HA_MCP_API_KEY=dev-admin-key
HA_MCP_ROLE=admin
HA_MCP_PURPOSE=operations

# ---------------------------------------------------------------------------
# FHIR R4 integration
#   Empty HA_FHIR_BASE_URL means "no EHR connected": ingest is unavailable and
#   the agent runs on the synthetic dataset alone. Ingest is pull-based; run
#   `ha-agent fhir sync --from https://fhir.example.org/r4` on a schedule.
#   HA_FHIR_TOKEN is a secret. It is read from the environment only - never
#   pass it as a command line flag, where it would land in shell history.
# ---------------------------------------------------------------------------
HA_FHIR_BASE_URL=
HA_FHIR_TOKEN=
HA_FHIR_TIMEOUT_S=30
HA_FHIR_PAGE_SIZE=100
HA_FHIR_MAX_PAGES=20

# Identifier system used to derive the internal patient id (the MRN).
# Leave empty to key patients by their FHIR logical id.
HA_FHIR_MRN_SYSTEM=

# Off by default. When on, a booked appointment is written back as a FHIR
# Appointment only after human approval, and only if the write succeeds is the
# local row created.
HA_FHIR_WRITE_ENABLED=false
HA_FHIR_VERIFY_TLS=true
